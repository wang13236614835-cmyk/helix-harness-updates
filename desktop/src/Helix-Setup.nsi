  File "${HELIX_SOURCE}\shell\helix.config.json"
  SetOverwrite on
  ReadRegStr $0 HKLM "Software\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${If} $0 == ""
    ReadRegStr $0 HKCU "Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" "pv"
  ${EndIf}
  ${If} $0 == ""
    InitPluginsDir
    SetOutPath "$PLUGINSDIR"
    File "${HELIX_WEBVIEW_REDIST}"
    DetailPrint "正在安装 Microsoft WebView2 官方运行库…"
    ExecWait '"$PLUGINSDIR\MicrosoftEdgeWebView2RuntimeInstallerX64.exe" /silent /install' $0
    ${If} $0 != 0
      MessageBox MB_ICONEXCLAMATION "WebView2 运行库安装尚未完成（代码 $0）。请稍后重新运行本安装程序。账号和项目已保留。"
    ${EndIf}
  ${EndIf}
  SetOutPath "$INSTDIR"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  CreateDirectory "$SMPROGRAMS\Helix 工作台"
  CreateShortCut "$DESKTOP\Helix 工作台.lnk" "$INSTDIR\Helix.exe" "" "$INSTDIR\Helix.exe" 0 SW_SHOWNORMAL
  CreateShortCut "$SMPROGRAMS\Helix 工作台\Helix 工作台.lnk" "$INSTDIR\Helix.exe" "" "$INSTDIR\Helix.exe" 0 SW_SHOWNORMAL
  WriteRegStr HKCU "Software\HelixWorkbench" "InstallPath" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "DisplayName" "Helix 工作台"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "DisplayVersion" "3.2.0"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "DisplayIcon" "$INSTDIR\Helix.exe"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\HelixWorkbench" "NoRepair" 1
SectionEnd
Section "Uninstall"
  SetRegView 64
  SetShellVarContext current
  StrLen $0 $INSTDIR
