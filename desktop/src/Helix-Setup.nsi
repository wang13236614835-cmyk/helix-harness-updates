
Unicode True
!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
Name "Helix 工作台 3.2.0"
OutFile "${HELIX_INSTALLER_OUT}"
InstallDir "D:\Applications\Helix"
RequestExecutionLevel user
SetCompressor /SOLID zlib
BrandingText "Helix 工作台"
VIProductVersion "3.2.0.0"
VIAddVersionKey /LANG=2052 "ProductName" "Helix 工作台"
VIAddVersionKey /LANG=2052 "FileDescription" "Helix Windows 桌面应用安装程序"
VIAddVersionKey /LANG=2052 "FileVersion" "3.2.0"
VIAddVersionKey /LANG=2052 "LegalCopyright" "Helix Harness"
!define MUI_ICON "${HELIX_SOURCE}\shell\app\icon.ico"
!define MUI_UNICON "${HELIX_SOURCE}\shell\app\icon.ico"
!define MUI_ABORTWARNING
!define MUI_WELCOMEPAGE_TITLE "安装 Helix 工作台"
!define MUI_WELCOMEPAGE_TEXT "独立应用窗口，双击桌面图标即可使用。$\r$\n$\r$\n安装包包含运行所需依赖，无需另外安装 Python。升级会保留账号、项目和同步设置。"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN "$INSTDIR\Helix.exe"
!define MUI_FINISHPAGE_RUN_TEXT "打开 Helix 工作台"
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "SimpChinese"
Function .onInit
  SetRegView 64
  ${IfNot} ${RunningX64}
    MessageBox MB_ICONSTOP "Helix 需要 64 位 Windows 10 或 11。"
    Abort
  ${EndIf}
  SetShellVarContext current
  StrCmp $INSTDIR "D:\Applications\Helix" 0 init_done
  ReadRegStr $0 HKCU "Software\HelixWorkbench" "InstallPath"
  ${If} $0 != ""
    StrCpy $INSTDIR $0
  ${ElseIf} ${FileExists} "D:\zcode-workspace\helix-harness\VERSION.json"
    StrCpy $INSTDIR "D:\zcode-workspace\helix-harness"
  ${ElseIfNot} ${FileExists} "D:\"
    StrCpy $INSTDIR "$LOCALAPPDATA\Programs\Helix"
  ${EndIf}
  init_done:
FunctionEnd
Section "Helix 工作台" SecMain
  SetShellVarContext current
  StrLen $0 $INSTDIR
  ${If} $0 < 8
    MessageBox MB_ICONSTOP "请选择专门用于 Helix 的安装文件夹。"
    Abort
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\Helix.exe"
    ExecWait '"$INSTDIR\Helix.exe" --shutdown'
    Sleep 3000
  ${EndIf}
  ${If} ${FileExists} "$INSTDIR\portable_launcher.py"
  ${AndIf} ${FileExists} "$INSTDIR\runtime\python\python.exe"
    DetailPrint "正在保存并停止原工作台…"
    nsExec::ExecToLog '"$INSTDIR\runtime\python\python.exe" "$INSTDIR\portable_launcher.py" --stop'
    Pop $0
  ${EndIf}
  SetOverwrite on
  SetOutPath "$INSTDIR"
  File "${HELIX_SOURCE}\CHANGELOG-3.0.md"
  File "${HELIX_SOURCE}\CHANGELOG-3.1.1.md"
  File "${HELIX_SOURCE}\CHANGELOG-3.1.md"
  File "${HELIX_SOURCE}\CHANGELOG-3.2.0.md"
  SetOutPath "$INSTDIR\desktop"
